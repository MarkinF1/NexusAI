# Separate from the native service's .env. No passwords or tokens here.
NEXUS_DOCKER_PROJECT=nexusai-docker
NEXUS_DOCKER_IMAGE=nexusai:local
NEXUS_DOCKER_BIND=127.0.0.1
NEXUS_DOCKER_PORT=8081
NEXUS_TRUSTED_PROXY=127.0.0.1
# To bind existing files/auth, use the owning Linux user's numeric UID/GID.
NEXUS_UID=1000
NEXUS_GID=1000
# Required only for ./docker.sh --auth ...; absolute existing directories:
# NEXUS_CLAUDE_DIR=/home/user/.claude
# NEXUS_CODEX_DIR=/home/user/.codex
