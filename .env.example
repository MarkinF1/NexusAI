# Скопируйте в .env и при необходимости поменяйте: cp .env.example .env

# Адрес и порт сайта. 127.0.0.1 — только с этой машины;
# 0.0.0.0 — из домашней сети (нужно, чтобы роутер мог проксировать на сервер).
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080

# IP обратного прокси, которому доверяем X-Forwarded-* (например, IP Keenetic 192.168.1.1).
NEXUS_TRUSTED_PROXY=127.0.0.1

# Где хранить пользователей, беседы и файлы. По умолчанию ./data рядом с проектом.
# NEXUS_DATA=/home/user/nexus-data

# Пути к CLI, если их нет в PATH.
# CLAUDE_BIN=/home/user/.local/bin/claude
# CODEX_BIN=/usr/bin/codex

# ---------------------------------------------------------------------------------
# Ниже — только первоначальные значения общих настроек. При первом старте они попадают в
# data/settings.json, дальше их меняют в «Настройки» → «Общие настройки» без перезапуска,
# а эти строки больше не читаются. Не задано — значение по умолчанию.
# ---------------------------------------------------------------------------------

# Какие нейросети использовать. Подключаются только те, что есть в системе:
# [claude, codex] — обе, [claude] — только claude. Пусто — все найденные.
NEXUS_ENGINES=[claude, codex]

# Модель claude по умолчанию для новых бесед: opus, sonnet или haiku.
NEXUS_MODEL=sonnet

# Предел одного ответа в секундах (обычно ответ останавливают кнопкой «Стоп»).
NEXUS_TIMEOUT=1800

# Бот Telegram: токен от @BotFather. Пусто — бота нет. Один токен нельзя опрашивать
# из двух мест: если этим ботом пользуется другая программа, заведите для сайта отдельного.
NEXUS_TG_TOKEN=

# Порог «Сжать беседу» в МБ для пользователей, которым его ещё не задали в «Памяти».
# 0 — не предлагать.
NEXUS_COMPACT_MB=10

# Как часто (в секундах) спрашивать у Anthropic и OpenAI свежую занятость подписки.
# 0 — не спрашивать: проценты обновятся только после запусков на сайте.
NEXUS_USAGE_REFRESH=120

# Модель распознавания голосовых на сайте и в Telegram (faster-whisper): small, medium,
# large-v3-turbo (а также tiny, base, large-v3). Чем больше, тем точнее, но медленнее и
# тяжелее для памяти. Скачивается при первом голосовом. Сменённая модель грузится при следующем голосовом.
NEXUS_STT_MODEL=small

# Язык голосовых (ru, en, ...). Пусто — определяется автоматически.
NEXUS_STT_LANG=

# Сколько update.sh ждёт окончания ответов перед перезапуском, секунд.
NEXUS_UPDATE_WAIT=1800
